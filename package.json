{
  "name": "@arnaud-zg/skills",
  "version": "0.0.0",
  "private": true,
  "description": "Arnaud Zheng's Claude Code plugin marketplace: Agent Skills, agents, hooks and MCP servers.",
  "homepage": "https://github.com/arnaud-zg/skills#readme",
  "bugs": {
    "url": "https://github.com/arnaud-zg/skills/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnaud-zg/skills.git"
  },
  "license": "MIT",
  "author": "Arnaud Zheng <arnaud.zg@gmail.com>",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md": "remark . --frail --quiet",
    "prepare": "lefthook install",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.vitest.json --noEmit"
  },
  "prettier": "@arnaud-zg/configs/prettier",
  "devDependencies": {
    "@arnaud-zg/configs": "^0.3.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-packagejson": "^3.0.3",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-preset-lint-recommended": "^7.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.10.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
