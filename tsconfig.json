{
  // The root config files (eslint.config.mjs, .remarkrc.mjs, commitlint.config.mjs) are left out
  // until @arnaud-zg/configs ships type declarations for its subpaths: TypeScript sees each one as an
  // untyped module and fails strict mode.
  "extends": "@arnaud-zg/configs/tsconfig/base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["vitest.config.ts", "plugins/*/skills/*/scripts/*.mjs"]
}
